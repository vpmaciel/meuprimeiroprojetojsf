<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
    xmlns="https://jakarta.ee/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="meuprimeiroprojetojsf" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Mapeamento das Entidades do Sistema -->
        <class>br.com.entidades.Pessoa</class>
        <class>br.com.entidades.Framework</class>
        <class>br.com.entidades.Lancamento</class>

        <properties>
            <!-- Configurações de Conexão com o PostgreSQL -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver" />
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/meuprimeiroprojetojsf" />
            <property name="jakarta.persistence.jdbc.user" value="postgres" />
            <property name="jakarta.persistence.jdbc.password" value="@Cia5555" />

            <!-- Dialeto do PostgreSQL para Hibernate 6 -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect" />

            <!-- Atualiza o schema automaticamente no banco -->
            <property name="hibernate.hbm2ddl.auto" value="update" />

            <!-- ======================================================== -->
            <!-- EXIBIR E FORMATAR SQL NO CONSOLE / TERMINAL              -->
            <!-- ======================================================== -->
            <!-- Exibe o SQL gerado pelo Hibernate no terminal -->
            <property name="hibernate.show_sql" value="false" />
            
            <!-- Indenta e formata as consultas SQL para facilitar a leitura -->
            <property name="hibernate.format_sql" value="false" />
            
            <!-- Mostra os comentários descrevendo a operação (INSERT, UPDATE, etc.) -->
            <property name="hibernate.use_sql_comments" value="false" />
            
            <!-- (Opcional) Exibe os parâmetros reais passados nos '?' do SQL -->
            <property name="trace" value="true" />
        </properties>
    </persistence-unit>
</persistence>